<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:vice="Vice.UI">
    <vice:MenuPanel title="Audio">
        <vice:SettingsSlider label="Master Volume" low-value="0" high-value="1" step="0.01" format="0%" class="default-focus">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="MasterVolume" binding-mode="TwoWay" />
            </Bindings>
        </vice:SettingsSlider>
    </vice:MenuPanel>
</ui:UXML>
