<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:vice="Vice.UI">
    <vice:MenuPanel title="Controls">
        <vice:SettingsSlider label="Mouse Sensitivity" low-value="0.01" high-value="1" step="0.01" format="0.00" class="default-focus">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="MouseSensitivity" binding-mode="TwoWay" />
            </Bindings>
        </vice:SettingsSlider>
        <vice:SettingsSlider label="Stick Sensitivity" low-value="30" high-value="360" step="5" format="0">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="StickSensitivity" binding-mode="TwoWay" />
            </Bindings>
        </vice:SettingsSlider>
        <vice:SettingsToggle label="Invert Y">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="InvertY" binding-mode="TwoWay" />
            </Bindings>
        </vice:SettingsToggle>
        <vice:SettingsToggle label="Head Bob">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="HeadBob" binding-mode="TwoWay" />
            </Bindings>
        </vice:SettingsToggle>
        <vice:SettingsToggle label="Idle Sway">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="IdleSway" binding-mode="TwoWay" />
            </Bindings>
        </vice:SettingsToggle>
    </vice:MenuPanel>
</ui:UXML>
