.menu {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--color-scrim);
}

.menu__panel {
    min-width: 720px;
    padding: var(--space-2);
    background-color: var(--color-surface);
}

.menu__title {
    margin-bottom: var(--space-2);
    font-size: var(--font-size-title);
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.menu-button {
    margin: 0;
    padding: var(--space-1);
    border-width: 0;
    font-size: var(--font-size-body);
    color: var(--color-text);
    background-color: transparent;
    transition-property: background-color;
    transition-duration: 0.08s;
}

.menu-button:hover {
    background-color: transparent;
}

.menu-button:focus {
    background-color: var(--color-accent);
}

.settings-row {
    flex-direction: row;
    margin: 0;
    padding: var(--space-1);
    transition-property: background-color;
    transition-duration: 0.08s;
}

.settings-row > .unity-base-field__label {
    min-width: 280px;
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-text-align: middle-left;
}

.settings-row > .unity-base-field__input {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.settings-row:focus {
    background-color: var(--color-accent);
}

.settings-row:focus > .unity-base-field__label {
    color: var(--color-text);
}

.settings-toggle__box {
    width: 28px;
    height: 28px;
    padding: 4px;
    border-width: 2px;
    border-color: var(--color-text);
}

.settings-toggle__check {
    flex-grow: 1;
    background-color: var(--color-text);
    visibility: hidden;
}

.settings-toggle--checked .settings-toggle__check {
    visibility: visible;
}

.settings-slider__track {
    flex-grow: 1;
    margin: 0;
}

.settings-slider__value {
    min-width: 96px;
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-text-align: middle-right;
}

.settings-dropdown__value {
    flex-grow: 1;
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.settings-dropdown__arrow {
    font-size: var(--font-size-body);
    color: var(--color-text);
}

.settings-dropdown__arrow--disabled {
    opacity: 0.3;
}

.settings-dropdown__overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.settings-dropdown__list {
    position: absolute;
    border-width: 2px;
    border-color: var(--color-accent);
    background-color: var(--color-surface);
}

.settings-dropdown__option {
    padding: var(--space-1);
    font-size: var(--font-size-body);
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.settings-dropdown__option--highlighted {
    background-color: var(--color-accent);
}
